# Tourist Karnataka - Environment Configuration
# Copy this file to .env to configure real email delivery and secret keys.

# ==========================================
# Real Email Delivery Configuration (Gmail SMTP)
# ==========================================
# 1. Go to your Google Account (myaccount.google.com) -> Security.
# 2. Enable "2-Step Verification" (if not already enabled).
# 3. Search for "App Passwords" in the top search bar.
# 4. Create an App Password for "Tourist App" (Google gives you a 16-character code like "abcd efgh ijkl mnop").
# 5. Paste your Gmail address and that 16-character code below:

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_HOST_USER=amrutha01nsgowda@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=Amrutha - Tourist Karnataka <amrutha01nsgowda@gmail.com>

# ==========================================
# Deployment Settings (Port 587 is open globally)
# ==========================================
# Port 587 with STARTTLS is universally allowed across cloud providers
# (Render, Railway, AWS, DigitalOcean, Heroku) without ISP port 25 blocking.
